    implement_cli [
        label="Implement CLI"
        shape="box"
        timeout="900s"
        allowed_tools="Bash,Write,Read"
        prompt="Implement foundry-lite/src/foundry/cli.py and src/foundry/__main__.py. Wire all modules into the CLI using click.

__main__.py:
  from foundry.cli import cli
  def main():
      cli()
  if __name__ == '__main__':
      main()

cli.py structure (use click):
  @click.group()
  def cli(): pass

## foundry doctor
  @cli.command()
  def doctor():
    from foundry.config import find_config, load_config
    from foundry.doctor import run_checks, print_doctor_results
    config_path = find_config(Path.cwd())
    cfg = load_config(config_path) if config_path else None
    checks = run_checks(config_path or Path('foundry.yaml'), cfg)
    sys.exit(print_doctor_results(checks))

## foundry run <profile>
  @cli.command()
  @click.argument('profile')
  @click.option('--json', 'output_json', is_flag=True)
  @click.option('--dry-run', is_flag=True)
  @click.option('--repo', type=click.Path(), default=None)
  def run(profile, output_json, dry_run, repo):
    1. If --repo: os.chdir(repo)
    2. Find foundry.yaml via find_config(Path.cwd())
       If not found: print to stderr 'foundry.yaml not found. Run foundry doctor.' then sys.exit(1)
    3. Load and validate config. If errors: print errors, sys.exit(1)
    4. If profile not in cfg['profiles']: print available profiles, sys.exit(1)
    5. Create run_dir: Path('.foundry') / 'runs' / run_id; mkdir parents
    6. execute_profile() from runner.py
    7. write_run_output() from output.py
    8. update_latest_symlink() from output.py
    9. If output_json: print(result_json_path.read_text()) to stdout
    10. sys.exit(run_result.exit_code)

IMPORTANT: Progress goes to stderr. Stdout is CLEAN unless --json.

## foundry latest
  @cli.command()
  @click.option('--summary', is_flag=True)
  @click.option('--json', 'output_json', is_flag=True)
  def latest(summary, output_json):
    latest_dir = Path('.foundry') / 'latest'
    If not exists: print 'No runs found' and exit 1
    If --summary: print (latest_dir / 'summary.md').read_text()
    Elif --json: print (latest_dir / 'result.json').read_text()
    Else: parse result.json and print one-line: '<run_id>  <profile>  <decision>  <duration>'

## foundry schedule (subgroup)
  @cli.group()
  def schedule(): pass

  @schedule.command('install')
  @click.argument('name')
  def schedule_install(name):
    Load foundry.yaml. Find schedules.<name>. Call scheduler.install().

  @schedule.command('list')
  def schedule_list():
    Call scheduler.list_schedules(). Print table.

  @schedule.command('remove')
  @click.argument('name')
  def schedule_remove(name):
    Call scheduler.remove(name). Print confirmation."
    ]

    verify_cli [
        label="Verify CLI?"
        shape="diamond"
        node_type="conditional"
        goal_gate="true"
        timeout="600s"
        allowed_tools="Bash,Read,Write"
        prompt="Verify the CLI implementation. Run from foundry-lite/:

1. uv run foundry --help  -- must list: doctor, run, latest, schedule
2. uv run foundry doctor --help  -- must show usage
3. uv run foundry run --help  -- must show PROFILE arg and --json/--dry-run/--repo flags
4. uv run foundry latest --help  -- must show --summary/--json flags
5. uv run foundry schedule --help  -- must list: install, list, remove
6. uv run python -c 'from foundry.cli import cli; print(\"import ok\")'

7. Create /tmp/test-foundry-cli/ with foundry.yaml:
   version: 1
   profiles:
     quick:
       gates:
         - id: echo-test
           run: echo hello
   Run: mkdir -p /tmp/test-foundry-cli && cat that yaml > /tmp/test-foundry-cli/foundry.yaml
   Then: cd /tmp/test-foundry-cli && git init && git config user.email t@t.com && git config user.name T && git add . && git commit -m init
   Then: cd /tmp/test-foundry-cli && uv --directory <abs-path-to-foundry-lite> run foundry run quick --dry-run
   Must print gate info to stderr and exit 0 without actually running gates.

Output PASS if all 7 checks pass, FAIL with step number and error details."
    ]

    fixup_cli [
        label="Fix CLI"
        shape="box"
        timeout="900s"
        allowed_tools="Bash,Write,Read"
        prompt="Fix CLI issues based on verification failures. Common issues:
- Missing click decorators or wrong argument names
- stdout vs stderr mixing (progress MUST go to stderr, stdout clean for --json)
- Import errors between modules
- --dry-run not implemented (should print gates list and exit without running)
- schedule subgroup not properly registered
- foundry.yaml not-found error message must say 'foundry.yaml not found. Run foundry doctor.'
- latest command failing when .foundry/latest symlink missing

Fix whatever specific steps failed in the verification."
    ]

    integration_test [
        label="Integration Test"
        shape="box"
        timeout="600s"
        allowed_tools="Bash,Read,Write"
        prompt="Run a full end-to-end integration test. Find the absolute path to foundry-lite first.

FOUNDRY_LITE=$(pwd)/foundry-lite   # or absolute path if already there

Step 1: Create test repo
  mkdir -p /tmp/foundry-int-test
  cd /tmp/foundry-int-test
  git init
  git config user.email test@test.com
  git config user.name Test

Step 2: Create foundry.yaml
  version: 1
  profiles:
    quick:
      gates:
        - id: echo-pass
          run: echo 'Gate passed'
        - id: warn-gate
          run: echo 'warn gate'
          allow_failure: true
          decision_on_failure: warn
    failing:
      gates:
        - id: will-fail
          run: sh -c 'exit 1'
    sentinel:
      gates:
        - id: needs-human-gate
          run: sh -c 'echo FOUNDRY_NEEDS_HUMAN; exit 0'

Step 3: Commit
  git add . && git commit -m 'init'

Step 4: Run quick profile
  cd /tmp/foundry-int-test && uv --directory $FOUNDRY_LITE run foundry run quick --json
  MUST: exit 0, create .foundry/runs/<run-id>/result.json, result.json parseable by python -c 'import json,sys; d=json.load(open(sys.argv[1])); assert d[\"decision\"]==\"pass\"; print(\"ok\")' .foundry/latest/result.json

Step 5: Run foundry latest
  cd /tmp/foundry-int-test && uv --directory $FOUNDRY_LITE run foundry latest
  MUST: print one-line status containing 'pass'

Step 6: Run failing profile
  cd /tmp/foundry-int-test && uv --directory $FOUNDRY_LITE run foundry run failing --json; echo exit:$?
  MUST: exit 1, result.json has decision=fail

Step 7: Run sentinel profile
  cd /tmp/foundry-int-test && uv --directory $FOUNDRY_LITE run foundry run sentinel --json; echo exit:$?
  MUST: exit 1, result.json has decision=needs_human

Step 8: Run doctor
  cd /tmp/foundry-int-test && uv --directory $FOUNDRY_LITE run foundry doctor
  MUST: not crash, print check results

Report step-by-step results. Note which passed and which failed with exact error output."
    ]

    verify_integration [
        label="Verify Integration?"
        shape="diamond"
        node_type="conditional"
        timeout="120s"
        allowed_tools="Bash,Read"
        prompt="Review the integration test output. Did all 8 steps pass?
- Step 4: foundry run quick --json exited 0, result.json valid, decision=pass
- Step 5: foundry latest printed one-line with 'pass'
- Step 6: foundry run failing exited 1, decision=fail in result.json
- Step 7: foundry run sentinel exited 1, decision=needs_human in result.json
- Step 8: foundry doctor ran without crashing
Output PASS if all passed, FAIL with which step(s) failed and exact error."
    ]

    fixup_integration [
        label="Fix Integration Issues"
        shape="box"
        timeout="900s"
        allowed_tools="Bash,Write,Read"
        prompt="Fix the integration test failures. Read failure details carefully and fix root cause in the right module.

Common failure causes by symptom:
- 'No such file or directory' for .foundry/runs: runner.py must create run_dir and logs/ subdir before writing
- JSON serialization error: datetime objects need .isoformat() not str()
- 'latest' symlink broken: output.py update_latest_symlink must use os.symlink with absolute target
- Wrong exit code: runner.py exit_code must be 0 for pass/warn, 1 for fail/needs_human; cli.py must call sys.exit(run_result.exit_code)
- sentinel not detected: runner.py must check output buffer for literal string 'FOUNDRY_NEEDS_HUMAN'
- doctor crashes: all check_* functions must catch all exceptions and return DoctorCheck(status='FAIL')
- Gate log path in result.json must be relative: 'logs/lint.log' not absolute path

After fixing, note which files were changed."
    ]

    commit_changes [
        label="Commit Changes"
        shape="box"
        timeout="120s"
        allowed_tools="Bash(git:*)"
        prompt="Stage and commit all changes made by this pipeline.
1. Run git diff --stat to review what changed
2. Stage the changed files: git add -A
3. Commit with a descriptive message:
   git commit -m 'feat: implement Foundry MVP Phase 1 -- doctor, run, latest, schedule commands with result.json output contract'"
    ]

    done [
        label="Done"
        shape="Msquare"
        timeout="120s"
        prompt="Pipeline complete. Foundry MVP Phase 1 implemented with foundry doctor, foundry run, foundry latest, foundry schedule install/list/remove, and structured result.json output."
    ]

    start -> scaffold
    scaffold -> verify_scaffold

    verify_scaffold -> implement_config [label="PASS" condition="preferred_label=PASS"]
    verify_scaffold -> fixup_scaffold [label="FAIL"]
    fixup_scaffold -> verify_scaffold [loop_restart="true"]

    implement_config -> verify_config
    verify_config -> implement_doctor [label="PASS" condition="preferred_label=PASS"]
    verify_config -> fixup_config [label="FAIL"]
    fixup_config -> verify_config [loop_restart="true"]

    implement_doctor -> verify_doctor
    verify_doctor -> implement_runner [label="PASS" condition="preferred_label=PASS"]
    verify_doctor -> fixup_doctor [label="FAIL"]
    fixup_doctor -> verify_doctor [loop_restart="true"]

    implement_runner -> verify_runner
    verify_runner -> implement_output [label="PASS" condition="preferred_label=PASS"]
    verify_runner -> fixup_runner [label="FAIL"]
    fixup_runner -> verify_runner [loop_restart="true"]

    implement_output -> verify_output
    verify_output -> implement_scheduler [label="PASS" condition="preferred_label=PASS"]
    verify_output -> fixup_output [label="FAIL"]
    fixup_output -> verify_output [loop_restart="true"]

    implement_scheduler -> verify_scheduler
    verify_scheduler -> implement_cli [label="PASS" condition="preferred_label=PASS"]
    verify_scheduler -> fixup_scheduler [label="FAIL"]
    fixup_scheduler -> verify_scheduler [loop_restart="true"]

    implement_cli -> verify_cli
    verify_cli -> integration_test [label="PASS" condition="preferred_label=PASS"]
    verify_cli -> fixup_cli [label="FAIL"]
    fixup_cli -> verify_cli [loop_restart="true"]

    integration_test -> verify_integration
    verify_integration -> commit_changes [label="PASS" condition="preferred_label=PASS"]
    verify_integration -> fixup_integration [label="FAIL"]
    fixup_integration -> verify_integration [loop_restart="true"]

    commit_changes -> done
}