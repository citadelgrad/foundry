digraph foundry_phase2 {
    label="Foundry Phase 2 — Agent Integration"
    goal="Implement Phase 2 features: foundry explain, parallel gates, watch mode, dagger runner backend, PAS/Reckoner integration docs"
    model="sonnet"

    start [
        label="Start"
        shape="Mdiamond"
        timeout="120s"
        prompt="Begin Foundry Phase 2 implementation. The codebase lives at foundry-lite/src/foundry/. Phase 1 modules already exist: runner.py, cli.py, config.py, output.py, doctor.py, scheduler.py. Phase 2 adds: explain.py, watcher.py, dagger_runner.py plus extensions to existing modules."
    ]

    update_deps [
        label="Add Phase 2 Dependencies"
        shape="box"
        timeout="300s"
        allowed_tools="Read,Write,Bash"
        prompt="Update foundry-lite/pyproject.toml to add Phase 2 dependencies. Read the current pyproject.toml first. Add to the dependencies list (do not duplicate existing entries): anthropic>=0.25 and watchdog>=4.0. Then run: cd foundry-lite && uv sync. Use uv only — never pip. Verify with: uv run python -c 'import anthropic; import watchdog; print(OK)'"
    ]

    verify_deps [
        label="Verify Dependencies"
        shape="diamond"
        node_type="conditional"
        timeout="120s"
        allowed_tools="Bash,Read"
        prompt="Verify Phase 2 dependencies are installed in foundry-lite/. Run: cd foundry-lite && uv run python -c 'import anthropic; print(anthropic.__version__)' and cd foundry-lite && uv run python -c 'import watchdog; print(watchdog.__version__)'. Also check pyproject.toml contains anthropic>=0.25 and watchdog>=4.0. Output PASS if both packages import and pyproject.toml has correct entries. Output FAIL with specific errors otherwise."
    ]

    fixup_deps [
        label="Fix Dependencies"
        shape="box"
        timeout="300s"
        allowed_tools="Read,Write,Bash"
        prompt="Fix dependency installation issues in foundry-lite/. Read the verification errors. If packages are missing from pyproject.toml, add anthropic>=0.25 and watchdog>=4.0. Run: cd foundry-lite && uv add anthropic && uv add watchdog. Use uv only — never pip. Re-run uv sync after any changes."
    ]

    implement_explain [
        label="Implement explain.py"
        shape="box"
        timeout="900s"
        allowed_tools="Read,Write,Bash"
        prompt="Create foundry-lite/src/foundry/explain.py implementing LLM failure explanation.\n\nThe module must contain:\n\n1. EXPLAIN_PROMPT string:\nGate '{gate_id}' {status} running: {command}\n\nLog output (last 8KB):\n{log}\n\nIn 5 or fewer concise bullet points, explain what failed and why. Be specific about file paths and line numbers if visible. Do not repeat the log verbatim.\n\n2. _tail(path: Path, nbytes: int) -> str helper that reads the last nbytes bytes of a file, returns empty string if file missing.\n\n3. explain_run(run_dir: Path, model: str = 'claude-haiku-4-5-20251001') -> str that:\n   a. Loads result.json from run_dir as JSON\n   b. Returns 'All gates passed. No explanation needed.' if result['decision'] == 'pass'\n   c. For each gate in result['gates'] where status is 'failed' or 'timed_out':\n      - Reads last 8192 bytes of the gate log file (path from gate['log'])\n      - Calls anthropic.Anthropic().messages.create(model=model, max_tokens=512, messages=[{'role':'user','content':EXPLAIN_PROMPT.format(...)}])\n      - Formats output as: ## Gate: {gate_id} ({status})\\n\\n{llm_response_text}\n   d. Returns all per-gate explanations joined with double newline\n\nImports needed: anthropic, json, pathlib.Path"
    ]

    verify_explain [
        label="Verify explain.py"
        shape="diamond"
        node_type="conditional"
        timeout="120s"
        allowed_tools="Bash,Read"
        prompt="Verify foundry-lite/src/foundry/explain.py:\n1. Run: cd foundry-lite && uv run python -c 'from foundry.explain import explain_run, EXPLAIN_PROMPT, _tail; print(OK)'\n2. Verify EXPLAIN_PROMPT contains all four placeholders: {gate_id}, {status}, {command}, {log}\n3. Verify _tail signature accepts (path, nbytes)\n4. Verify explain_run signature accepts (run_dir, model) with model defaulting to claude-haiku-4-5-20251001\nOutput PASS if all checks succeed. Output FAIL with specific errors otherwise."
    ]

    fixup_explain [
        label="Fix explain.py"
        shape="box"
        timeout="300s"
        allowed_tools="Read,Write,Bash"
        prompt="Fix issues in foundry-lite/src/foundry/explain.py based on verification errors. Common issues: missing EXPLAIN_PROMPT placeholders ({gate_id}, {status}, {command}, {log}), wrong function signatures, import errors with anthropic, _tail not handling missing files. Fix the specific errors reported and ensure explain_run, _tail, and EXPLAIN_PROMPT are all importable."
    ]

    implement_parallel [
        label="Implement Parallel Gate Runner"
        shape="box"
        timeout="900s"
        allowed_tools="Read,Write,Bash"
        prompt="Extend foundry-lite/src/foundry/runner.py to support parallel gate execution.\n\nFirst read runner.py to understand existing structures (GateResult, ProfileResult, run_profile, _run_subprocess).\n\nChanges to make:\n\n1. Add parallel: bool = False field to the Profile config model (check where Profile is defined, likely config.py — if so, update config.py instead).\n\n2. Add run_profile_parallel(profile, run_dir: Path) -> ProfileResult function to runner.py:\n   - Import concurrent.futures.ThreadPoolExecutor at top of file\n   - Use ThreadPoolExecutor to submit all gates simultaneously\n   - Each gate writes to run_dir/logs/<gate-id>.log (same as sequential)\n   - Record actual start/finished timestamps per gate using time.time() or datetime.utcnow()\n   - On timeout: call process.kill() (not fail-fast — all gates run to completion)\n   - After all futures complete: derive decision using same logic as sequential mode\n   - Return ProfileResult\n\n3. In run_profile() dispatcher: check if profile.parallel is True, call run_profile_parallel(); otherwise use existing sequential logic.\n\nDo not break existing sequential behavior."
    ]

    verify_parallel [
        label="Verify Parallel Runner"
        shape="diamond"
        node_type="conditional"
        timeout="120s"
        allowed_tools="Bash,Read"
        prompt="Verify parallel runner implementation in foundry-lite/:\n1. Run: cd foundry-lite && uv run python -c 'from foundry.runner import run_profile_parallel; print(OK)'\n2. Check runner.py imports ThreadPoolExecutor from concurrent.futures\n3. Check run_profile_parallel is defined and accepts (profile, run_dir) arguments\n4. Run any existing tests: cd foundry-lite && uv run python -m pytest tests/ -x -q 2>/dev/null || echo no-tests\nOutput PASS if run_profile_parallel imports cleanly and ThreadPoolExecutor is used. Output FAIL with specific errors otherwise."
    ]

    fixup_parallel [
        label="Fix Parallel Runner"
        shape="box"
        timeout="300s"
        allowed_tools="Read,Write,Bash"
        prompt="Fix issues in foundry-lite/src/foundry/runner.py parallel implementation. Read the verification errors. Common issues: missing ThreadPoolExecutor import, wrong function signature for run_profile_parallel, not returning ProfileResult, breaking sequential run_profile path. Fix specific errors while preserving existing sequential behavior."
    ]

    implement_watcher [
        label="Implement watcher.py"
        shape="box"
        timeout="900s"
        allowed_tools="Read,Write,Bash"
        prompt="Create foundry-lite/src/foundry/watcher.py implementing the file-change re-run loop.\n\nRequired imports: watchdog.observers.Observer, watchdog.events.FileSystemEventHandler, threading, pathlib.Path, sys, time.\n\nDefine class FoundryWatcher:\n\n__init__(self, repo: Path, profile: str, debounce: float):\n  Store repo, profile, debounce. Create Observer instance. Create threading.Timer slot (self._timer = None). Create threading.Lock.\n\nstart(self):\n  1. Run the profile once immediately (import and call run_profile from runner.py)\n  2. Print: [foundry] watching for changes (Ctrl-C to stop)...\n  3. Create inner class _Handler(FileSystemEventHandler) with on_any_event calling self._schedule_rerun\n  4. Schedule observer on str(repo) with _Handler\n  5. Start observer\n  6. Loop: time.sleep(1) until KeyboardInterrupt -> call self.stop() -> sys.exit(0)\n\nstop(self):\n  Cancel pending timer if any. Stop and join observer.\n\n_schedule_rerun(self, event):\n  If event path contains .foundry: return (ignore run artifacts).\n  Cancel existing timer. Set new threading.Timer(self.debounce, self._do_rerun). Start timer.\n\n_do_rerun(self):\n  Print separator line. Run profile. Print: [foundry] watching for changes (Ctrl-C to stop)..."
    ]

    verify_watcher [
        label="Verify watcher.py"
        shape="diamond"
        node_type="conditional"
        timeout="120s"
        allowed_tools="Bash,Read"
        prompt="Verify foundry-lite/src/foundry/watcher.py:\n1. Run: cd foundry-lite && uv run python -c 'from foundry.watcher import FoundryWatcher; print(OK)'\n2. Verify FoundryWatcher has __init__, start, stop methods\n3. Verify imports include Observer from watchdog.observers and FileSystemEventHandler from watchdog.events\n4. Verify _schedule_rerun or similar handler checks for .foundry in path to ignore run artifacts\nOutput PASS if class imports and has required interface. Output FAIL with specific errors otherwise."
    ]

    fixup_watcher [
        label="Fix watcher.py"
        shape="box"
        timeout="300s"
        allowed_tools="Read,Write,Bash"
        prompt="Fix issues in foundry-lite/src/foundry/watcher.py based on verification errors. Common issues: missing watchdog imports, FoundryWatcher missing start/stop methods, _schedule_rerun not filtering .foundry/ paths, threading.Timer not properly used for debounce. Fix the specific errors while keeping the class interface: __init__(repo, profile, debounce), start(), stop()."
    ]

    implement_dagger [
        label="Implement dagger_runner.py + Config"
        shape="box"
        timeout="900s"
        allowed_tools="Read,Write,Bash"
        prompt="Implement Dagger runner backend across two files.\n\nFirst read config.py and runner.py to understand existing Gate, Profile models and _run_subprocess.\n\nChanges to foundry-lite/src/foundry/config.py:\n1. Add DaggerBlock dataclass (or Pydantic model, match existing style): fields: module: str, function: str, args: list[str] = field(default_factory=list)\n2. Add dagger: Optional[DaggerBlock] = None to the Gate model\n3. In validate_config (or gate validation): enforce exactly one of run, act, dagger is set per gate. Raise ValueError if zero or multiple are set.\n\nCreate foundry-lite/src/foundry/dagger_runner.py:\n1. Import _run_subprocess from foundry.runner and GateResult (or whatever result type _run_subprocess returns)\n2. Import Path from pathlib\n3. Define run_dagger_gate(gate, log_path: Path, timeout: int) -> GateResult:\n   cmd = ['dagger', 'call', '-m', gate.dagger.module, gate.dagger.function] + (gate.dagger.args or [])\n   return _run_subprocess(cmd, log_path, timeout)\n\nChanges to foundry-lite/src/foundry/runner.py:\n4. In gate dispatch logic: when gate.dagger is set, import and call run_dagger_gate from dagger_runner."
    ]

    verify_dagger [
        label="Verify Dagger Runner"
        shape="diamond"
        node_type="conditional"
        timeout="120s"
        allowed_tools="Bash,Read"
        prompt="Verify dagger runner implementation in foundry-lite/:\n1. Run: cd foundry-lite && uv run python -c 'from foundry.dagger_runner import run_dagger_gate; print(OK)'\n2. Run: cd foundry-lite && uv run python -c 'from foundry.config import DaggerBlock; print(OK)'\n3. Read config.py and verify gate validation enforces exactly one of run/act/dagger per gate\n4. Run: cd foundry-lite && uv run python -c 'from foundry.config import validate_config; print(OK)' (or whatever the validation function is named)\nOutput PASS if all imports succeed and DaggerBlock exists. Output FAIL with specific errors otherwise."
    ]

    fixup_dagger [
        label="Fix Dagger Runner"
        shape="box"
        timeout="300s"
        allowed_tools="Read,Write,Bash"
        prompt="Fix issues in foundry-lite/src/foundry/dagger_runner.py and config.py based on verification errors. Common issues: DaggerBlock not exported from config, run_dagger_gate wrong import path for _run_subprocess, gate validation not enforcing mutual exclusivity of run/act/dagger, dataclass vs Pydantic style mismatch with rest of config. Fix specific errors reported."
    ]

    update_cli [
        label="Update CLI for Phase 2"
        shape="box"
        timeout="900s"
        allowed_tools="Read,Write,Bash"
        prompt="Update foundry-lite/src/foundry/cli.py to expose all Phase 2 features. First read existing cli.py to understand current structure (argparse vs click vs typer).\n\nAdd these changes:\n\n1. New 'explain' subcommand:\n   - Flags: --latest (boolean, default True), --run <run-id string>, --model <string default claude-haiku-4-5-20251001>\n   - Before calling explain_run: check os.environ.get('ANTHROPIC_API_KEY') — if missing, print 'ANTHROPIC_API_KEY not set. Required for foundry explain.' to stderr and sys.exit(1)\n   - Call explain_run(run_dir, model) from foundry.explain\n   - Print result to stdout, always exit 0\n\n2. Add --watch flag to 'foundry run <profile>' subcommand:\n   - If --watch and --json both set: print 'Cannot use --json with --watch' to stderr and sys.exit(1)\n   - If --watch: create FoundryWatcher(repo=Path('.'), profile=profile, debounce=debounce_seconds) and call watcher.start()\n\n3. Add --debounce <str> flag to 'foundry run' (default '2s'):\n   - Parse: strip trailing 's', convert to float\n\n4. Update 'foundry doctor' to check dagger binary when any gate in foundry.yaml uses a dagger block:\n   - Use shutil.which('dagger') to find binary\n   - Print: [PASS] dagger: binary found at <path> or [FAIL] dagger: not found on PATH\n\nDo not break existing CLI surface."
    ]

    verify_cli [
        label="Verify CLI Updates"
        shape="diamond"
        node_type="conditional"
        timeout="120s"
        allowed_tools="Bash,Read"
        prompt="Verify CLI updates in foundry-lite/:\n1. Run: cd foundry-lite && uv run python -m foundry --help 2>&1 | grep -E 'explain|run|doctor'\n2. Run: cd foundry-lite && uv run python -m foundry explain --help 2>&1\n3. Run: cd foundry-lite && uv run python -m foundry run --help 2>&1 | grep -E 'watch|debounce'\n4. Run: cd foundry-lite && uv run python -c 'from foundry.cli import main; print(OK)'\nOutput PASS if explain subcommand exists, --watch and --debounce flags appear in run help, and no import errors. Output FAIL with specific errors and missing items."
    ]

    fixup_cli [
        label="Fix CLI"
        shape="box"
        timeout="300s"
        allowed_tools="Read,Write,Bash"
        prompt="Fix issues in foundry-lite/src/foundry/cli.py based on verification errors. Common issues: explain subcommand not registered in subparser/group, --watch/--debounce flags missing from run subcommand, ANTHROPIC_API_KEY check missing, import errors from newly added modules (explain, watcher). Fix specific reported errors without breaking existing run/doctor/latest/schedule subcommands."
    ]

    write_integration_doc [
        label="Write INTEGRATION.md"
        shape="box"
        timeout="300s"
        allowed_tools="Read,Write"
        prompt="Write foundry-lite/INTEGRATION.md documenting how PAS pipelines and Reckoner agents consume Foundry output.\n\nThe file must contain exactly these four sections:\n\n## Reading result.json\n\nPython snippet showing:\nimport json, subprocess\nresult = subprocess.run(['foundry', 'run', 'quick', '--json'], capture_output=True, text=True)\ndata = json.loads(result.stdout)\nif data['agent_recommendation']['safe_to_continue']:\n    # proceed to next step\n    pass\nelse:\n    reason = data['agent_recommendation']['summary']\n    # halt or escalate\n\n## PAS Pipeline Node Pattern\n\nA Graphviz .dot snippet showing a pipeline node labeled 'quality_gate' that runs 'foundry run quick --json', with a PASS edge to 'continue_work' and a FAIL edge to 'halt'.\n\n## Reckoner Gate Pattern\n\nA YAML snippet showing a Reckoner step definition that wraps foundry run --json as a gate with pass condition on safe_to_continue == true and fail condition otherwise.\n\n## Environment Requirements\n\nBulleted list:\n- foundry binary on PATH\n- ANTHROPIC_API_KEY environment variable set (only required for foundry explain, not for foundry run)\n- For non-CWD repos: pass --repo <path> flag to foundry run"
    ]

    verify_integration_doc [
        label="Verify INTEGRATION.md"
        shape="diamond"
        node_type="conditional"
        timeout="120s"
        allowed_tools="Read,Bash"
        prompt="Verify foundry-lite/INTEGRATION.md:\n1. Check file exists: ls foundry-lite/INTEGRATION.md\n2. Read the file and verify all four required sections are present:\n   - '## Reading result.json' with Python code using safe_to_continue\n   - '## PAS Pipeline Node Pattern' with a .dot snippet\n   - '## Reckoner Gate Pattern' with YAML\n   - '## Environment Requirements' with bulleted list mentioning foundry on PATH and ANTHROPIC_API_KEY\n3. Verify the Python snippet references data['agent_recommendation']['safe_to_continue']\nOutput PASS if all sections present and code is correct. Output FAIL listing which sections are missing or incorrect."
    ]

    fixup_integration_doc [
        label="Fix INTEGRATION.md"
        shape="box"
        timeout="120s"
        allowed_tools="Read,Write"
        prompt="Fix foundry-lite/INTEGRATION.md based on verification failures. Add any missing sections. Required sections: Reading result.json (Python snippet with safe_to_continue check), PAS Pipeline Node Pattern (Graphviz .dot node snippet with PASS/FAIL edges), Reckoner Gate Pattern (YAML step definition), Environment Requirements (foundry on PATH, ANTHROPIC_API_KEY note, --repo flag for non-CWD). Do not remove existing correct sections."
    ]

    commit_changes [
        label="Commit Changes"
        shape="box"
        timeout="120s"
        allowed_tools="Bash(git:*)"
        prompt="Stage and commit all Phase 2 changes made by this pipeline.\n1. Run git diff --stat to review what changed\n2. Stage all changes: git add -A\n3. Commit with message: feat: foundry phase 2 — explain, parallel gates, watch mode, dagger runner, integration docs\n4. Print the list of committed files"
    ]

    done [
        label="Done"
        shape="Msquare"
        timeout="120s"
        prompt="Foundry Phase 2 implementation pipeline complete. All five features delivered: foundry explain (LLM failure analysis), parallel gate execution, --watch mode, Dagger runner backend, and INTEGRATION.md for PAS/Reckoner consumers."
    ]

    start -> update_deps
    update_deps -> verify_deps
    verify_deps -> implement_explain [label="PASS"]
    verify_deps -> fixup_deps [label="FAIL"]
    fixup_deps -> verify_deps [loop_restart="true"]

    implement_explain -> verify_explain
    verify_explain -> implement_parallel [label="PASS"]
    verify_explain -> fixup_explain [label="FAIL"]
    fixup_explain -> verify_explain [loop_restart="true"]

    implement_parallel -> verify_parallel
    verify_parallel -> implement_watcher [label="PASS"]
    verify_parallel -> fixup_parallel [label="FAIL"]
    fixup_parallel -> verify_parallel [loop_restart="true"]

    implement_watcher -> verify_watcher
    verify_watcher -> implement_dagger [label="PASS"]
    verify_watcher -> fixup_watcher [label="FAIL"]
    fixup_watcher -> verify_watcher [loop_restart="true"]

    implement_dagger -> verify_dagger
    verify_dagger -> update_cli [label="PASS"]
    verify_dagger -> fixup_dagger [label="FAIL"]
    fixup_dagger -> verify_dagger [loop_restart="true"]

    update_cli -> verify_cli
    verify_cli -> write_integration_doc [label="PASS"]
    verify_cli -> fixup_cli [label="FAIL"]
    fixup_cli -> verify_cli [loop_restart="true"]

    write_integration_doc -> verify_integration_doc
    verify_integration_doc -> commit_changes [label="PASS"]
    verify_integration_doc -> fixup_integration_doc [label="FAIL"]
    fixup_integration_doc -> verify_integration_doc [loop_restart="true"]

    commit_changes -> done
}