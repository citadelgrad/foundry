    fixup_auto_explain -> verify_auto_explain [loop_restart="true"]
    verify_auto_explain -> impl_approval_gate [label="PASS" condition="preferred_label=PASS"]
    impl_approval_gate -> verify_approval_gate
    verify_approval_gate -> fixup_approval_gate [label="FAIL" condition="preferred_label=FAIL"]
    fixup_approval_gate -> verify_approval_gate [loop_restart="true"]
    verify_approval_gate -> commit_changes [label="PASS" condition="preferred_label=PASS"]
    commit_changes -> done
}