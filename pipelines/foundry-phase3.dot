digraph foundry_phase3 {
    label="Foundry Phase 3 — Ecosystem Implementation"
    goal="Implement Beads integration, LLM evidence capture, foundry init, and multi-repo support in foundry-lite/src/foundry/"
    model="sonnet"
    rankdir="TB"

    start [
        label="Start"
        shape="Mdiamond"
        timeout="120s"
        prompt="Pipeline start. Proceed to implementing Foundry Phase 3 features sequentially."
    ]

    impl_beads [
        label="Implement Beads Integration"
        shape="box"
        timeout="900s"
        allowed_tools="Read,Write,Bash,Grep,Glob"
        prompt="Implement Beads issue creation on failure in foundry-lite/src/foundry/runner.py. Add a function maybe_create_beads_issue(config, result, run_dir) that: (1) reads beads_cfg = config.get('integrations', {}).get('beads', {}), returns early if empty; (2) checks if decision is 'fail' and beads_cfg.get('on_failure') is True, or decision is 'needs_human' and beads_cfg.get('on_needs_human') is True — if neither condition met, return; (3) reads (run_dir / 'summary.md').read_text()[:4096]; (4) builds title as 'foundry: {profile} {decision} @ {commit[:7]}' using result['profile'], result['decision'], result['repo']['commit']; (5) calls subprocess.run(['bd', 'create', '--title', title, '--description', summary, '--type', 'bug', '--priority', '2'], capture_output=True, text=True); (6) if returncode == 0, parses issue_id as proc.stdout.strip().split()[-1], prints '[foundry] beads issue created: {issue_id}' to stderr, sets result['beads_issue_id'] = issue_id; (7) catches FileNotFoundError for bd missing from PATH — warns to stderr and returns; (8) if returncode != 0 warns to stderr and returns — never raises. Call maybe_create_beads_issue at the end of run_profile() after result.json and summary.md are written. Update config schema handling to accept integrations.beads with fields on_failure (bool), on_needs_human (bool), labels (list of str)."
    ]

    verify_beads [
        label="Verify Beads Integration"
        shape="diamond"
        node_type="conditional"
        timeout="300s"
        allowed_tools="Read,Bash,Grep"
        goal_gate="true"
        prompt="Verify the Beads integration in foundry-lite/src/foundry/runner.py. Check each condition and output PASS only if ALL pass, otherwise output FAIL with the list of failing checks: (1) maybe_create_beads_issue function exists with signature (config, result, run_dir); (2) subprocess.run call uses exactly ['bd', 'create', '--title', title, '--description', summary, '--type', 'bug', '--priority', '2'] with capture_output=True, text=True; (3) function is called from run_profile() after writing output files; (4) FileNotFoundError for missing bd is caught, warns to stderr, does not raise; (5) non-zero returncode is caught, warns to stderr, does not raise; (6) result['beads_issue_id'] is set only when returncode == 0; (7) function returns early when integrations.beads is absent from config; (8) on_failure and on_needs_human flags are checked independently."
    ]

    fixup_beads [
        label="Fix Beads Integration"
        shape="box"
        timeout="600s"
        allowed_tools="Read,Write,Bash,Grep"
        prompt="Fix all issues identified in the Beads integration verification of foundry-lite/src/foundry/runner.py. Address every FAIL item reported by the verify step. The maybe_create_beads_issue function must: use subprocess.run(['bd', 'create', '--title', title, '--description', summary, '--type', 'bug', '--priority', '2'], capture_output=True, text=True); catch FileNotFoundError when bd is absent from PATH and warn to stderr without raising; check returncode != 0 and warn to stderr without raising; only set result['beads_issue_id'] when returncode == 0; be called from run_profile() after writing result.json; respect on_failure and on_needs_human flags independently; return early when integrations.beads is absent. Fix only what was reported as failing — do not change passing logic."
    ]

    impl_evidence [
        label="Implement Evidence Capture"
        shape="box"
        timeout="900s"
        allowed_tools="Read,Write,Bash,Grep,Glob"
        prompt="Implement LLM gateway policy evidence capture in foundry-lite/src/foundry/output.py. Add import hashlib at the top. Add function write_evidence(run_dir: Path, result: dict) that: (1) computes result_bytes = json.dumps(result, sort_keys=True).encode(); (2) computes result_hash = 'sha256:' + hashlib.sha256(result_bytes).hexdigest(); (3) builds evidence dict with exactly these keys: schema_version=1, run_id=result['run_id'], decision=result['decision'], profile=result['profile'], repo_commit=result['repo']['commit'], result_hash=result_hash, foundry_version=result.get('foundry_version', 'unknown'), issued_at=result['finished_at']; (4) writes (run_dir / 'evidence.json').write_text(json.dumps(evidence, indent=2)). Call write_evidence in the same code path as write_result and write_summary so evidence.json appears in every .foundry/runs/<run-id>/ directory. Also in foundry-lite/src/foundry/cli.py: add --evidence flag to the foundry latest subcommand that, when passed, reads evidence.json from the most recent run directory under .foundry/runs/ and prints it to stdout — follow the same pattern as the existing --json and --summary flags."
    ]

    verify_evidence [
        label="Verify Evidence Capture"
        shape="diamond"
        node_type="conditional"
        timeout="300s"
        allowed_tools="Read,Bash,Grep"
        goal_gate="true"
        prompt="Verify the evidence capture implementation in foundry-lite/src/foundry/output.py and cli.py. Output PASS only if ALL checks pass, otherwise output FAIL with list of failing checks: (1) import hashlib present in output.py; (2) write_evidence(run_dir, result) function exists with correct signature; (3) result_hash is computed as 'sha256:' + hashlib.sha256(json.dumps(result, sort_keys=True).encode()).hexdigest(); (4) evidence dict contains all 8 required keys: schema_version, run_id, decision, profile, repo_commit, result_hash, foundry_version, issued_at; (5) write_evidence is called in the main run output path alongside write_result; (6) evidence.json is written to run_dir using json.dumps with indent=2; (7) foundry latest --evidence flag exists in cli.py and prints evidence.json content to stdout."
    ]

    fixup_evidence [
        label="Fix Evidence Capture"
        shape="box"
        timeout="600s"
        allowed_tools="Read,Write,Bash,Grep"
        prompt="Fix all issues identified in the evidence capture verification. Address every FAIL item reported. In foundry-lite/src/foundry/output.py: add import hashlib at top if missing; ensure write_evidence(run_dir, result) computes result_hash as 'sha256:' + hashlib.sha256(json.dumps(result, sort_keys=True).encode()).hexdigest(); ensure evidence dict contains all 8 keys (schema_version=1, run_id, decision, profile, repo_commit, result_hash, foundry_version, issued_at); ensure write_evidence is called in the output-writing path alongside write_result; write to run_dir / 'evidence.json' with json.dumps(evidence, indent=2). In cli.py: add --evidence flag to foundry latest that reads and prints evidence.json from the most recent run directory. Fix only what was reported as failing."
    ]

    impl_init [
        label="Implement foundry init"
        shape="box"
        timeout="900s"
        allowed_tools="Read,Write,Bash,Grep,Glob"
        prompt="Create foundry-lite/src/foundry/init_cmd.py as a new module. Implement: (1) detect_gates(repo: Path) -> list[dict] — checks (repo / 'Makefile').exists() and reads its text, for each target in ('lint', 'test', 'typecheck', 'build') appends {'id': target, 'run': 'make ' + target} if '{target}:' appears in content; checks (repo / 'justfile').exists() and does the same with 'just ' prefix; globs repo / '.github' / 'workflows' / '*.yml' and for the first match appends {'id': 'ci', 'act': {'workflow': str(match.relative_to(repo)), 'event': 'pull_request'}, 'timeout': '20m'}; returns the collected list; (2) generate_foundry_yaml(repo: Path) -> str — calls detect_gates, splits results into non_act (no 'act' key) and act_gates, builds YAML string with version: 1, profiles.quick containing non_act gates, profiles.full containing non_act + act_gates, schedules.nightly with profile: full and cron: '0 2 * * *'; if detect_gates returns empty list, include commented placeholder examples in the YAML; return the YAML string; (3) run_init(repo: Path) — if (repo / 'foundry.yaml').exists() print 'foundry.yaml already exists. Remove it first or edit manually.' to stderr and sys.exit(1); otherwise call generate_foundry_yaml, write to repo / 'foundry.yaml', print detection summary lines to stdout like '[foundry] detected: Makefile (lint, test)' for each detected runner and '[foundry] wrote foundry.yaml (N gates in quick, M gates in full)'. In cli.py register 'foundry init' subcommand that calls run_init(Path.cwd())."
    ]

    verify_init [
        label="Verify foundry init"
        shape="diamond"
        node_type="conditional"
        timeout="300s"
        allowed_tools="Read,Bash,Grep"
        goal_gate="true"
        prompt="Verify the foundry init implementation in foundry-lite/src/foundry/init_cmd.py and cli.py. Output PASS only if ALL checks pass, otherwise output FAIL with list of failing checks: (1) init_cmd.py exists as a new file; (2) detect_gates checks Makefile for '{target}:' patterns for lint, test, typecheck, build; (3) detect_gates checks justfile with same pattern producing 'just {target}' run commands; (4) detect_gates globs .github/workflows/*.yml and produces act gate dict with workflow path and event pull_request; (5) generate_foundry_yaml produces YAML with version: 1, profiles.quick, profiles.full, and schedules.nightly with cron '0 2 * * *'; (6) run_init exits 1 with correct message when foundry.yaml already exists; (7) run_init writes foundry.yaml and prints detection summary lines to stdout; (8) foundry init subcommand registered in cli.py calling run_init(Path.cwd())."
    ]

    fixup_init [
        label="Fix foundry init"
        shape="box"
        timeout="600s"
        allowed_tools="Read,Write,Bash,Grep"
        prompt="Fix all issues identified in the foundry init verification. Address every FAIL item reported. In foundry-lite/src/foundry/init_cmd.py: ensure detect_gates checks Makefile for '{target}:' in ('lint', 'test', 'typecheck', 'build') producing {'id': target, 'run': 'make ' + target}; add justfile detection with same pattern and 'just ' prefix; add .github/workflows/*.yml glob detection returning act gate with workflow relative path and event pull_request; ensure generate_foundry_yaml builds YAML with version: 1, profiles quick (non-act gates) and full (all gates), schedules.nightly (profile: full, cron: '0 2 * * *'); ensure run_init calls sys.exit(1) with message 'foundry.yaml already exists. Remove it first or edit manually.' when file present; ensure stdout detection summary is printed. In cli.py register init subcommand. Fix only what was reported as failing."
    ]

    impl_multirepo [
        label="Implement Multi-Repo Support"
        shape="box"
        timeout="900s"
        allowed_tools="Read,Write,Bash,Grep,Glob"
        prompt="Create foundry-lite/src/foundry/global_config.py as a new module. Implement: CONFIG_PATH = Path.home() / '.config' / 'foundry' / 'config.yaml'; load_global_config() -> dict that returns {'version': 1, 'repos': []} if CONFIG_PATH does not exist, else yaml.safe_load(CONFIG_PATH.read_text()); save_global_config(cfg: dict) that calls CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True) then CONFIG_PATH.write_text(yaml.dump(cfg, default_flow_style=False)) — wrap in try/except PermissionError and sys.exit(1) with message including CONFIG_PATH and the error; add_repo(path: Path, alias: str | None = None) that loads config, sets alias = alias or path.name, removes any existing entry where r['path'] == str(path), appends {'path': str(path), 'alias': alias}, saves; list_repos() -> list[dict] that loads config, for each repo entry finds latest run by globbing {path}/.foundry/runs/*/ sorted by name descending, reads result.json decision if found, returns list of dicts with alias, path, last_run (date string or None), last_decision (or None). In foundry-lite/src/foundry/cli.py: add 'foundry repos' subcommand group with three subcommands — 'repos add [--alias NAME]' calls add_repo(Path.cwd(), alias); 'repos list' calls list_repos() and prints table formatted as 'alias  /path/to/repo  2026-06-15  pass' (no-run repos show '(no runs)  -'); 'repos remove <alias-or-path>' removes matching entry by alias or path from global config. In foundry run: after loading local config, call load_global_config() and check if any repo entry path matches str(Path.cwd()); if found, include '(repo: {alias})' in the run start progress line."
    ]

    verify_multirepo [
        label="Verify Multi-Repo Support"
        shape="diamond"
        node_type="conditional"
        timeout="300s"
        allowed_tools="Read,Bash,Grep"
        goal_gate="true"
        prompt="Verify the multi-repo support in foundry-lite/src/foundry/global_config.py and cli.py. Output PASS only if ALL checks pass, otherwise output FAIL with list of failing checks: (1) global_config.py exists with CONFIG_PATH = Path.home() / '.config' / 'foundry' / 'config.yaml'; (2) load_global_config returns {'version': 1, 'repos': []} when file is absent; (3) save_global_config calls mkdir(parents=True, exist_ok=True) before writing; (4) save_global_config catches PermissionError and exits 1 with informative message; (5) add_repo deduplicates by path string and defaults alias to path.name; (6) foundry repos add subcommand exists in cli.py accepting optional --alias; (7) foundry repos list subcommand exists and formats output with alias, path, date, decision columns; (8) foundry repos remove subcommand exists accepting alias or path; (9) foundry run checks global config against CWD and prints repo alias in progress output when matched."
    ]

    fixup_multirepo [
        label="Fix Multi-Repo Support"
        shape="box"
        timeout="600s"
        allowed_tools="Read,Write,Bash,Grep"
        prompt="Fix all issues identified in the multi-repo support verification. Address every FAIL item reported. In foundry-lite/src/foundry/global_config.py: ensure CONFIG_PATH = Path.home() / '.config' / 'foundry' / 'config.yaml'; ensure load_global_config returns {'version': 1, 'repos': []} when file absent; ensure save_global_config calls CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True); wrap save in try/except PermissionError printing path and error then sys.exit(1); ensure add_repo removes existing entry matching str(path) before appending and defaults alias to path.name. In cli.py: add repos subcommand group with add (--alias optional), list (tabular output with alias/path/date/decision), and remove (by alias or path) subcommands; in foundry run load global config and if CWD matches a registered repo path print the alias in the run start progress line. Fix only what was reported as failing."
    ]

    commit_changes [
        label="Commit Changes"
        shape="box"
        timeout="120s"
        allowed_tools="Bash(git:*)"
        prompt="Stage and commit all changes made by this pipeline. 1. Run git diff --stat to review what changed. 2. Stage all changed and new files: git add -A. 3. Commit with message: 'feat(phase3): implement beads integration, evidence capture, foundry init, multi-repo support'. The commit must include all new and modified files in foundry-lite/src/foundry/ — runner.py, output.py, cli.py, init_cmd.py, and global_config.py."
    ]

    done [
        label="Done"
        shape="Msquare"
        timeout="120s"
        prompt="Pipeline complete. Foundry Phase 3 features implemented and committed: Beads issue creation on failure, LLM gateway evidence capture with SHA-256 result hash, foundry init command with repo detection, and multi-repo support with global config."
    ]

    start -> impl_beads
    impl_beads -> verify_beads
    verify_beads -> impl_evidence [label="PASS" condition="preferred_label=PASS"]
    verify_beads -> fixup_beads [label="FAIL"]
    fixup_beads -> verify_beads [loop_restart="true"]

    impl_evidence -> verify_evidence
    verify_evidence -> impl_init [label="PASS" condition="preferred_label=PASS"]
    verify_evidence -> fixup_evidence [label="FAIL"]
    fixup_evidence -> verify_evidence [loop_restart="true"]

    impl_init -> verify_init
    verify_init -> impl_multirepo [label="PASS" condition="preferred_label=PASS"]
    verify_init -> fixup_init [label="FAIL"]
    fixup_init -> verify_init [loop_restart="true"]

    impl_multirepo -> verify_multirepo
    verify_multirepo -> commit_changes [label="PASS" condition="preferred_label=PASS"]
    verify_multirepo -> fixup_multirepo [label="FAIL"]
    fixup_multirepo -> verify_multirepo [loop_restart="true"]

    commit_changes -> done
}